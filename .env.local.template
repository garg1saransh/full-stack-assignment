# =====================================================
# Kontrora — local environment (Saransh Garg fork)
# =====================================================
# SETUP:
#   1. cp .env.local.template .env.local   (or: npm run setup:env)
#   2. Fill Supabase credentials (Dashboard → Settings → API)
#   3. Apply supabase/schema.sql then supabase/seed-roles.sql
#   4. npm run seed:users
#   5. npm run test:estimates
#   6. npm run dev

# =====================================================
# SUPABASE (CLOUD) — required
# =====================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_your_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# =====================================================
# APP SETTINGS
# =====================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
LOG_LEVEL=debug
NODE_ENV=development
NEXT_PUBLIC_DEMO_MODE=false

# =====================================================
# SECURITY (optional for local assignment)
# =====================================================
# SETUP_SECRET=change-me-to-something-secure
# CRON_SECRET=change-me-to-something-secure

# =====================================================
# SMTP (optional)
# =====================================================
# SMTP_HOST=smtp.your-domain.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM=Kontrora <noreply@your-domain.com>

# =====================================================
# OPTIONAL: RATE LIMITING
# =====================================================
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# ENABLE_RATE_LIMIT=false

# =====================================================
# ESCROW (optional — Supabase-backed in this fork)
# =====================================================
GO_ESCROW_SERVICE_URL=http://localhost:4001
